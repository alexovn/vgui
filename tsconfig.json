{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "packages/vue/src/**/*.ts",
    "packages/vue/src/**/*.vue",
    "packages/playground/src/**/*.ts",
    "packages/playground/src/**/*.vue"
  ]
}
