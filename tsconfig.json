{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true
  },
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "packages/vue/lib/**/*.ts",
    "packages/vue/lib/**/*.vue",
    "packages/playground/**/*.ts",
    "packages/playground/**/*.vue"
  ]
}
